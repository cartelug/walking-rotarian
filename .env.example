# Node 24.14+; copy privately to your hosting's environment, never to the website.
PORT=8080
HOST=0.0.0.0
STATIC_DIR=dist
DATA_DIR=/var/lib/walking-rotarian
# HTTPS backend address including the same BASE_PATH used in the build.
PUBLIC_URL=
ALLOWED_ORIGINS=https://cartelug.github.io
# Public frontend setting, also available through GitHub's WALKING_ROTARIAN_API_URL variable.
API_URL=
# Optional email connection. MAIL_FROM must be an authorised sending address.
RESEND_API_KEY=
MAIL_FROM=
# Optional Facebook Page connection. Never use an account password here.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=
