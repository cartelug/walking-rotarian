{
  "name": "walking-rotarian-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Walking Rotarian website, live journal and secure publishing server. No third-party runtime dependencies.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node tools/check_site.mjs",
    "check:images": "node tools/check_images.mjs",
    "ingest": "node tools/ingest-drive.mjs",
    "serve": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "create-owner": "node server/create-owner.mjs"
  },
  "engines": { "node": ">=24.14" }
}
